{
  "name": "dsh-fox-pet",
  "version": "1.0.0",
  "private": true,
  "description": "Folio the fox — a companion pet for the DeepSeek Harness web UI",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "desktop-pet",
    "web-ui",
    "companion",
    "animation"
  ],
  "license": "MIT",
  "author": "Alih-b",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alih-b/fox-pet.git",
    "directory": "dsh"
  },
  "homepage": "https://github.com/Alih-b/fox-pet/tree/main/dsh#readme",
  "bugs": {
    "url": "https://github.com/Alih-b/fox-pet/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "fox-pet.client.js",
    "fox-pet.host.js",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node test/build-bundle.mjs",
    "test": "node test/simulate-source-shape.mjs && node test/simulate-bundle.mjs && node test/simulate-engine.mjs && node test/simulate-idle.mjs && node test/simulate-render-styles.mjs && node test/simulate-interactions.mjs",
    "test:eyes": "node test/verify-eye-state.mjs",
    "idle:dump": "node test/dump-idle.mjs",
    "verify:deployed": "./test/verify-deployed.sh"
  }
}
